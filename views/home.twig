<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Travel Planner</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            background: url('https://source.unsplash.com/featured/3840x2160/?travel,dark') no-repeat center center fixed;
            background-size: cover;
            overflow-x: hidden;
            transform: translateZ(0);
        }

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 20px 0;
            background-color: rgba(0, 0, 0, 0.7);
            z-index: 999;
            transition: background-color 0.3s ease;
            transform: translateZ(100px);
        }

        header:hover {
            background-color: rgba(0, 0, 0, 0.9);
        }

        header .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
            display: flex;
        }

        nav ul li {
            margin: 0 10px;
            position: relative;
        }

        nav ul li a {
            text-decoration: none;
            color: #fff;
            font-weight: bold;
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #ffa500;
        }

        nav ul li::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: #fff;
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.3s ease;
        }

        nav ul li:hover::before {
            transform: scaleX(1);
            transform-origin: left;
        }

        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            height: 100%;
            animation: fadeIn 1s ease;
            transform: translateZ(200px);
        }

        .container h1,
        .container p {
            text-align: center;
            opacity: 0;
            animation: slideIn 1s ease forwards;
        }

        .container:hover {
            cursor: pointer;
        }

        .container:hover h1,
        .container:hover p {
            animation: slideIn 1s ease forwards, fadeIn 1s ease forwards;
        }

        .container:hover {
            transform: scale(1.05);
        }

        .content {
            text-align: center;
            padding: 20px;
            background-color: rgba(255, 255, 255, 0.8);
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
            margin: 20px;
            opacity: 0;
            transform: translateY(50%);
            transition: transform 0.5s, opacity 0.5s;
            transform: translateZ(300px);
        }

        .container:hover .content {
            transform: translateY(0);
            opacity: 1;
        }

        .content h2 {
            color: #333;
            margin-bottom: 10px;
        }

        .content p {
            color: #666;
            line-height: 1.6;
        }

        .content:hover {
            cursor: pointer;
        }

        .content:hover a {
            text-decoration: underline;
        }

        .content a {
            color: #ffa500;
            transition: color 0.3s;
        }

        .content a:hover {
            color: #333;
        }

        .content a:hover::before {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 2px;
            background-color: #ffa500;
        }

        .content a:hover::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -5px;
            height: 2px;
            background-color: #ffa500;
        }

        .content a:focus {
            outline: none;
        }

        .content a:focus::before,
        .content a:focus::after {
            background-color: #333;
        }
    </style>

</head>

<body>
    <header>
        <div class="container">
            <nav>
                <ul>
                   <li><a href="/" class="home-link">Home</a></li>
                                   <li><a href="/Destination" class="destinations-link">Destinations</a></li>
                                   <li><a href="/itinerary" class="itinerary-link">Planner</a></li>
                                   <li><a href="/about" class="about-link">About</a></li>
                                   <li><a href="/contact" class="contact-link">Contact</a></li>
                </ul>
            </nav>
            <div class="content" onclick="location.href='index.twig';" style="cursor: pointer;">
                <h2>Welcome to RoamEase</h2>
                <p>Plan your next adventure with ease!</p>
            </div>
        </div>
    </header>
    <script> document.querySelector('.home-link').addEventListener('click', function (e) { e.preventDefault(); document.querySelector('.content').style.opacity = 0; setTimeout(function () { document.location.href = "index.twig"; }, 500); }); </script>
</body>

</html>