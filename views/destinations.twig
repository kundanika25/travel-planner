<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Destinations</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #000000, #4b0082, #ff0000, #ffd700, #008000, #0000ff);
            background-size: 600% 600%;
            animation: gradientBG 10s ease infinite;
            color: #fff;
            overflow-x: hidden;
        }

        @keyframes gradientBG {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .container {
            width: 100vw;
            height: 100vh;
            background: #f5f5f5;
            box-shadow: 0 30px 50px #dbdbdb;
            position: relative;
        }

        .container .slide .item {
            width: 20vw;
            height: 30vw;
            position: absolute;
            top: 50%;
            transform: translate(0, -50%);
            border-radius: 20px;
            box-shadow: 0 30px 50px #505050;
            background-position: 50% 50%;
            background-size: cover;
            display: inline-block;
            transition: 0.5s;
        }

        .slide .item:nth-child(1),
        .slide .item:nth-child(2) {
            top: 0;
            left: 0;
            transform: translate(0, 0);
            border-radius: 0;
            width: 100%;
            height: 100%;
        }

        .slide .item:nth-child(3) {
            left: 50%;
        }

        .slide .item:nth-child(4) {
            left: calc(50% + 22vw);
        }

        .slide .item:nth-child(5) {
            left: calc(50% + 44vw);
        }

        /* here n = 0, 1, 2, 3,... */
        .slide .item:nth-child(n + 6) {
            left: calc(50% + 66vw);
            opacity: 0;
        }

        .item img {
            width: 100%;
            height: 100%;
            border-radius: 20px;
            object-fit: cover;
        }

        .item .content {
            position: absolute;
            top: 50%;
            left: 10vw;
            width: 30vw;
            text-align: left;
            color: #eee;
            transform: translate(0, -50%);
            font-family: system-ui;
            display: none;
        }

        .slide .item:nth-child(2) .content {
            display: block;
        }

        .content .name {
            font-size: 4vw;
            text-transform: uppercase;
            font-weight: bold;
            opacity: 0;
            animation: animate 1s ease-in-out 1 forwards;
        }

        .content .des {
            margin-top: 1vw;
            margin-bottom: 2vw;
            opacity: 0;
            animation: animate 1s ease-in-out 0.3s 1 forwards;
        }

        .content button {
            padding: 1vw 2vw;
            border: none;
            cursor: pointer;
            opacity: 0;
            animation: animate 1s ease-in-out 0.6s 1 forwards;
        }

        @keyframes animate {
            from {
                opacity: 0;
                transform: translate(0, 100px);
                filter: blur(33px);
            }

            to {
                opacity: 1;
                transform: translate(0);
                filter: blur(0);
            }
        }

        .button {
            width: 100%;
            text-align: center;
            position: absolute;
            bottom: 2vw;
        }

        .button button {
            width: 4vw;
            height: 3.5vw;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            margin: 0 0.5vw;
            border: 1px solid #000;
            transition: 0.3s;
        }

        .button button:hover {
            background: #ababab;
            color: #fff;
        }

        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem;
            background: #000;
            z-index: 100;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.3);
        }

        .menu-toggle {
            display: none;
        }

        .nav-links {
            display: flex;
            justify-content: center;
            list-style-type: none;
            padding: 0;
            margin: 0;
        }

        .nav-links li {
            padding: 0 1rem;
        }

        .nav-links a {
            color: #fff;
            text-decoration: none;
            transition: color 0.3s;
        }

        .nav-links a:hover {
            color: #ccc;
        }

        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
                position: absolute;
                top: 1rem;
                right: 1rem;
                cursor: pointer;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 100%;
                left: 0;
                width: 100%;
                background: #000;
                flex-direction: column;
            }

            .nav-links li {
                text-align: center;
                padding: 1rem;
            }

            .nav-links.active {
                display: flex;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="menu-toggle" id="menu-toggle">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <ul class="nav-links" id="nav-links">
           <li><a href="/" class="home-link">Home</a></li>
                           <li><a href="/Destination" class="destinations-link">Destinations</a></li>
                           <li><a href="/itinerary" class="itinerary-link">Planner</a></li>
                           <li><a href="/about" class="about-link">About</a></li>
                           <li><a href="/contact" class="contact-link">Contact</a></li>
        </ul>
    </nav>
    <div class="container">
        <div class="slide">
            <div class="item" style="background-image: url(https://i.ibb.co/qCkd9jS/img1.jpg);">
                <img src="https://i.ibb.co/qCkd9jS/img1.jpg" alt="Switzerland">
                <div class="content">
                    <div class="name">Switzerland</div>
                    <div class="des">The land of mountains and chocolate!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://i.ibb.co/jrRb11q/img2.jpg);">
                <img src="https://i.ibb.co/jrRb11q/img2.jpg" alt="Finland">
                <div class="content">
                    <div class="name">Finland</div>
                    <div class="des">Experience the land of a thousand lakes!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://i.ibb.co/NSwVv8D/img3.jpg);">
                <img src="https://i.ibb.co/NSwVv8D/img3.jpg" alt="Iceland">
                <div class="content">
                    <div class="name">Iceland</div>
                    <div class="des">Discover the land of fire and ice!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://i.ibb.co/Bq4Q0M8/img4.jpg);">
                <img src="https://i.ibb.co/Bq4Q0M8/img4.jpg" alt="Australia">
                <div class="content">
                    <div class="name">Australia</div>
                    <div class="des">Explore the outback and the Great Barrier Reef!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://i.ibb.co/jTQfmTq/img5.jpg);">
                <img src="https://i.ibb.co/jTQfmTq/img5.jpg" alt="Netherlands">
                <div class="content">
                    <div class="name">Netherlands</div>
                    <div class="des">Bike through the charming canals of Amsterdam!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://source.unsplash.com/featured/?new,york,city);">
                <img src="https://source.unsplash.com/featured/?new,york,city" alt="New York City">
                <div class="content">
                    <div class="name">New York City</div>
                    <div class="des">The city that never sleeps!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://source.unsplash.com/featured/?paris,france);">
                <img src="https://source.unsplash.com/featured/?paris,france" alt="Paris">
                <div class="content">
                    <div class="name">Paris</div>
                    <div class="des">The city of love!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://source.unsplash.com/featured/?tokyo,japan);">
                <img src="https://source.unsplash.com/featured/?tokyo,japan" alt="Tokyo">
                <div class="content">
                    <div class="name">Tokyo</div>
                    <div class="des">Experience the vibrant culture of Japan!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://source.unsplash.com/featured/?rome,italy);">
                <img src="https://source.unsplash.com/featured/?rome,italy" alt="Rome">
                <div class="content">
                    <div class="name">Rome</div>
                    <div class="des">Discover ancient history and breathtaking architecture!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://source.unsplash.com/featured/?london,england);">
                <img src="https://source.unsplash.com/featured/?london,england" alt="London">
                <div class="content">
                    <div class="name">London</div>
                    <div class="des">Explore the iconic landmarks of the UK capital!</div>
                    <button>See More</button>
                </div>
            </div>
            <div class="item" style="background-image: url(https://source.unsplash.com/featured/?dubai,uae);">
                <img src="https://source.unsplash.com/featured/?dubai,uae" alt="Dubai">
                <div class="content">
                    <div class="name">Dubai</div>
                    <div class="des">Experience luxury and futuristic architecture in Dubai!</div>
                    <button>See More</button>
                </div>
            </div>
        </div>
        <div class="button">
            <button class="prev"><i class="fas fa-arrow-left"></i></button>
            <button class="next"><i class="fas fa-arrow-right"></i></button>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const seeMoreButtons = document.querySelectorAll('.content button');

            seeMoreButtons.forEach(button => {
                button.addEventListener('click', function () {
                    window.location.href = '/itinerary';
                });
            });

            let next = document.querySelector('.next');
            let prev = document.querySelector('.prev');

            next.addEventListener('click', function () {
                let items = document.querySelectorAll('.item');
                document.querySelector('.slide').appendChild(items[0]);
            });

            prev.addEventListener('click', function () {
                let items = document.querySelectorAll('.item');
                document.querySelector('.slide').prepend(items[items.length - 1]);
            });

            document.getElementById('menu-toggle').addEventListener('click', () => {
                document.getElementById('nav-links').classList.toggle('active');
            });
        });
    </script>
</body>

</html>