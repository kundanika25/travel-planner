<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fitness Tracker - Workout Entry</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 500px;
            margin: 20px auto;
            padding: 20px;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        h1, h2 {
            color: #333;
            text-align: center;
        }
        form {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        input[type="text"],
        input[type="number"],
        select {
            width: calc(100% - 12px);
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }
        button {
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 10px 20px;
            cursor: pointer;
            display: block;
            margin: 0 auto;
        }
        button:hover {
            background-color: #0056b3;
        }
        .error {
            color: red;
            text-align: center;
        }
        .success {
            color: green;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Fitness Tracker - Workout Entry</h1>

    <form id="workoutForm">
        <label for="exerciseType">Exercise Type:</label>
        <select id="exerciseType" name="exerciseType">
            <option value="">Select exercise type</option>
            <option value="cardio">Cardio</option>
            <option value="strength">Strength Training</option>
            <option value="flexibility">Flexibility</option>
        </select>
        <span id="exerciseTypeError" class="error"></span>

        <label for="duration">Duration (minutes):</label>
        <input type="number" id="duration" name="duration" placeholder="Enter duration">
        <span id="durationError" class="error"></span>

        <label for="intensity">Intensity Level:</label>
        <select id="intensity" name="intensity">
            <option value="">Select intensity level</option>
            <option value="low">Low</option>
            <option value="medium">Medium</option>
            <option value="high">High</option>
        </select>
        <span id="intensityError" class="error"></span>

        <label for="caloriesBurned">Calories Burned:</label>
        <input type="number" id="caloriesBurned" name="caloriesBurned" placeholder="Enter calories burned">
        <span id="caloriesBurnedError" class="error"></span>

        <label for="heartRate">Heart Rate (bpm):</label>
        <input type="number" id="heartRate" name="heartRate" placeholder="Enter heart rate">
        <span id="heartRateError" class="error"></span>

        <button type="submit" onclick="validateWorkout(event)">Submit</button>
    </form>
</div>

<script>
    function validateWorkout(event) {
        event.preventDefault();

        validateExerciseType();
        validateDuration();
        validateIntensity();
        validateCaloriesBurned();
        validateHeartRate();
    }

    function validateExerciseType() {
        const exerciseType = document.getElementById('exerciseType').value;
        const exerciseTypeError = document.getElementById('exerciseTypeError');

        if (exerciseType === '') {
            exerciseTypeError.textContent = 'Please select an exercise type.';
        } else {
            exerciseTypeError.textContent = '';
        }
    }

    function validateDuration() {
        const duration = parseInt(document.getElementById('duration').value);
        const durationError = document.getElementById('durationError');

        if (isNaN(duration) || duration < 5 || duration > 180) {
            durationError.textContent = 'Duration must be between 5 minutes and 3 hours (180 minutes).';
        } else {
            durationError.textContent = '';
        }
    }

    function validateIntensity() {
        const intensity = document.getElementById('intensity').value;
        const intensityError = document.getElementById('intensityError');

        if (intensity === '') {
            intensityError.textContent = 'Please select an intensity level.';
        } else {
            intensityError.textContent = '';
        }
    }

    function validateCaloriesBurned() {
        const caloriesBurned = parseInt(document.getElementById('caloriesBurned').value);
        const caloriesBurnedError = document.getElementById('caloriesBurnedError');

        if (isNaN(caloriesBurned) || caloriesBurned < 50 || caloriesBurned > 1500) {
            caloriesBurnedError.textContent = 'Calories burned must be between 50 and 1500.';
        } else {
            caloriesBurnedError.textContent = '';
        }
    }

    function validateHeartRate() {
        const heartRate = parseInt(document.getElementById('heartRate').value);
        const heartRateError = document.getElementById('heartRateError');

        if (isNaN(heartRate) || heartRate < 50 || heartRate > 200) {
            heartRateError.textContent = 'Heart rate must be between 50 and 200 bpm.';
        } else {
            heartRateError.textContent = '';
        }
    }
</script>

</body>
</html>
