<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Planner</title>
    <link href="https://fonts.googleapis.com/css2?family=Hackney&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Hackney', sans-serif; /* Change font-family to Hackney */
            background-image: url('https://source.unsplash.com/3840x2160/?travel,dark,nature,landscape');
            background-size: cover;
            background-position: center;
            color: #fff;
            overflow-x: hidden;
        }

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 20px 0;
            background-color: rgba(0, 0, 0, 0.7);
            z-index: 9999;
        }

        nav ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
            text-align: center;
        }

        nav ul li {
            display: inline;
            margin-right: 20px;
        }

        nav ul li a {
            text-decoration: none;
            color: #fff;
            font-weight: bold;
            transition: color 0.3s;
        }

        nav ul li a:hover {
            color: #ffa500; /* Change to desired hover color */
        }

        .home-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 50px;
            font-size: 1.5em;
            line-height: 1.5;
            text-align: center;
        }

        .hero-section h2 {
            font-size: 3em;
            color: #fff;
            margin-bottom: 20px;
        }

        .btn {
            display: inline-block;
            background-color: #ffa500; /* Change to desired button color */
            color: #000; /* Change to desired button text color */
            padding: 10px 20px;
            border-radius: 5px;
            text-transform: uppercase;
            font-weight: bold;
            margin-top: 20px;
            transition: background-color 0.3s;
            text-decoration: none;
        }

        .btn:hover {
            background-color: #ffd700; /* Change to desired hover button color */
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        /* Book animation styles */
        .book-animation {
            width: 0;
            height: 100%;
            position: fixed;
            top: 0;
            left: 0;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 99999;
            overflow: hidden;
            transition: width 0.8s ease;
        }

        .book-animation.active {
            width: 100%;
        }

        .book-animation img {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            max-width: 100%;
            max-height: 100%;
            opacity: 0;
            transition: opacity 0.8s ease;
        }

        .book-animation.active img {
            opacity: 1;
        }

        .section {
            margin-top: 50px;
        }

        .section h3 {
            font-size: 2em;
            margin-bottom: 20px;
        }

        .section p {
            font-size: 1.2em;
            color: #eee;
            margin-bottom: 20px;
        }

        .destination-list {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
        }

        .destination-card {
            width: 300px;
            margin: 20px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            transition: transform 0.5s ease;
        }

        .destination-card:hover {
            transform: translateY(-10px);
        }

        .destination-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .destination-info {
            padding: 20px;
        }

        .destination-info h4 {
            font-size: 1.5em;
            margin-bottom: 10px;
        }

        .destination-info p {
            font-size: 1em;
            color: #ccc;
            /* Stylish caption */
            background-color: rgba(0, 0, 0, 0.5);
            padding: 5px 10px;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><a href="/" class="home-link">Home</a></li>
                <li><a href="/Destination" class="destinations-link">Destinations</a></li>
                <li><a href="/itinerary" class="itinerary-link">Planner</a></li>
                <li><a href="/about" class="about-link">About</a></li>
                <li><a href="/contact" class="contact-link">Contact</a></li>
            </ul>
        </nav>
    </header>
    
    <div class="book-animation">
        <img src="https://media.giphy.com/media/dAdB7CUwvYt9i/giphy.gif" alt="Book Animation">
    </div>

    <div class="home-container">
        <div class="hero-section">
        <div class="logout-btn">
                                <button onclick="logout()">Logout</button>
                                </div>
            <h2>Welcome to RoamEase</h2>
            <p>Plan your next adventure with ease!</p>
            <a href="/Destination" class="btn">Explore Destinations</a>
        </div>
        <div class="about-section section">
            <h3>About RoamEase</h3>
            <p>RoamEase is a web application designed to help you plan your trips efficiently. Whether you're looking for inspiration, searching for attractions, or organizing your itinerary, Travel Planner has you covered.</p>
        </div>
        <div class="featured-section section">
            <h3>Featured Destinations</h3>
            <div class="destination-list">
                <div class="destination-card">
                    <img src="https://source.unsplash.com/featured/?new,york,city" alt="New York City" class="destination-image">
                    <div class="destination-info">
                        <h4>New York City</h4>
                        <p>The city that never sleeps!</p>
                    </div>
                </div>
                <div class="destination-card">
                    <img src="https://source.unsplash.com/featured/?paris,france" alt="Paris" class="destination-image">
                    <div class="destination-info">
                        <h4>Paris</h4>
                        <p>The city of love!</p>
                    </div>
                </div>
                <div class="destination-card">
                    <img src="https://source.unsplash.com/featured/?tokyo,japan" alt="Tokyo" class="destination-image">
                    <div class="destination-info">
                        <h4>Tokyo</h4>
                        <p>The bustling metropolis of Japan!</p>
                    </div>
                </div>

            </div>
        </div>
        <div class="activities-section section">
            <h3>Popular Activities</h3>
            <ul>
                <li>
                    <h4>Hiking</h4>
                    <p>Explore nature's wonders on foot!</p>
                </li>
                <li>
                    <h4>Sightseeing</h4>
                    <p>Discover landmarks and attractions!</p>
                </li>
                <li>
                    <h4>Food Tours</h4>
                    <p>Indulge in culinary delights!</p>
                </li>
            </ul>
        </div>
        <div class="testimonials-section section">
            <h3>Testimonials</h3>
            <ul>
                <li>
                    <p>"One of the best experiences you get could ever get"</p>
                    <p>- Akshita Sachdeva</p>
                </li>
                <li>
                    <p>"Amazing app! It made planning my trip so much easier."</p>
                    <p>- Soham Chatterjee</p>
                </li>
                <li>
                    <p>"Highly recommended for anyone who loves to travel!"</p>
                    <p>- Kundanika </p>
                </li>
            </ul>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelector('.book-animation').classList.add('active');
            setTimeout(function() {
                document.querySelector('.book-animation').style.display = 'none';
            }, 2000); 
        });

        function logout() {
            // Perform logout actions, such as clearing cookies and redirecting
            fetch('/logout', { method: 'GET' })
                .then(response => {
                    if (response.redirected) {
                        window.location.href = response.url; // Redirect to login page
                    }
                })
                .catch(error => {
                    console.error('Error during logout:', error);
                });
        }
    </script>
</body>
</html>
